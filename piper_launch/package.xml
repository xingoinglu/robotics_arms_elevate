<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_launch</name>
  <version>0.1.0</version>
  <description>
    Safe-by-default launch orchestration for Piper elevator-button tasks.
  </description>
  <maintainer email="xie@todo.todo">xie</maintainer>
  <license>Apache-2.0</license>

  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>piper</exec_depend>
  <exec_depend>piper_pbvs_control</exec_depend>
  <exec_depend>piper_with_gripper_moveit</exec_depend>
  <exec_depend>ros2cli</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
